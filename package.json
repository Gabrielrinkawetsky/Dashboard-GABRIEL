{
  "name": "www-dashboard-com",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:api": "node --watch --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "dev:web": "vite --port 5180 --strictPort",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "auth:setup": "node --env-file-if-exists=.env scripts/setup-admin.js",
    "test:auth": "node --disable-warning=ExperimentalWarning scripts/test-auth.js",
    "test:security": "node --disable-warning=ExperimentalWarning scripts/test-security.js",
    "test:vercel": "node --disable-warning=ExperimentalWarning scripts/test-vercel-entry.js"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "express": "^5.2.1",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=22"
  }
}
